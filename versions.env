# Pinned component versions for compliance-claw.
#
# This is the single source of truth: bump versions HERE, never inline in
# scripts or the Dockerfile. Both scripts/ and the Dockerfile source this file.
#
# Two documented carve-outs, because neither location can read a sourced file:
#   1. image digests, pinned on the Dockerfile's FROM lines
#   2. GitHub Action commit SHAs, pinned on `uses:` lines in .github/workflows/
# Those are the only pins not in this file. A pin audit looks in three places.

# Bumping this REQUIRES re-pinning the runtime image digest on the Dockerfile's
# second FROM line; the tag here alone does not move the build.
OPENCLAW_VERSION=2026.7.1

# THE PRETORIN BINARY IN THE IMAGE IS AN IMMUTABLE SEED, NOT THE CLI A DEPLOYMENT
# RUNS. First boot copies it (write-if-absent, the same idiom as config seeding)
# to /home/node/.pretorin/bin/pretorin in the pretorin-state volume, and that copy
# is the one canonical active CLI: it is first on PATH, it is what
# mcp.servers.pretorin.command points at, and it is NEVER replaced by container
# recreation or an image upgrade. This matches upstream's own canonical MCP path,
# which `pretorin link` exists to pin ("MCP hosts are configured against the one
# stable path ~/.pretorin/bin/pretorin so host config survives reinstalls and
# upgrades").
#
# So bumping this moves the seed for FRESH deployments only. An existing
# deployment's CLI is moved by scripts/pretorin-update.sh, which delegates to the
# CLI's own signed `pretorin update`.
#
# 0.28.7 IS A FLOOR, NOT A PREFERENCE. Standalone self-update does not exist
# before it: 0.28.2 answers `pretorin update` with "Self-update isn't available
# for binary installs yet" and exits 0. A seed older than 0.28.7 therefore
# produces a deployment that can never update itself.
PRETORIN_VERSION=0.28.7

# The agent's default model, baked into the config template at BUILD time. This is
# an image-build choice, not a runtime one: changing it here needs a rebuild.
#
# NO MODEL CREDENTIAL IS EVER BAKED IN. Provider authentication happens at
# DEPLOYMENT time and persists in the OpenClaw state volume. The POC's tested path
# is OpenAI/ChatGPT device-code login.
#
# To change the model on an EXISTING deployment without rebuilding:
#   docker compose run --rm cli openclaw models set <provider/model>
#   docker compose restart openclaw
#
# Selecting the model from .env at runtime is NOT implemented; it is recorded in
# README.md as internal-pilot / product work.
MODEL=openai/gpt-5.6-sol

# Revision of the shipped template set (openclaw-config.template.json +
# agents-md.template). BUMP THIS whenever either template changes.
#
# Both are seeded write-if-absent into the state volume and never overwritten, so
# an existing deployment keeps its old copies. The entrypoint compares this
# number against ~/.openclaw/.compliance-claw-templates and warns — warns only,
# never edits — when the volume is behind. A volume with no marker reads as 0,
# which is every Phase 3 deployment, so those warn too.
#   0 = no marker: a volume seeded before Phase 4 shipped the marker
#   2 = Phase 4 (adds mcp.servers.pretorin.cwd; provenance rules in AGENTS.md)
#   3 = Phase 5 (Slack channel patch on fresh seed; AGENTS.md context-switch rule)
#   4 = MCP runs from the persistent binary; skills block removed; the updater
#       plugin's load path (and, under Slack, its allowlist entry)
CONFIG_TEMPLATE_VERSION=4

# The OpenClaw Slack channel plugin. NOT bundled: `openclaw plugins list` in
# 2026.7.1 shows 70 stock plugins and slack is not among them, so it comes from
# npm as an official external package.
#
# `openclaw plugins install` would put it in ~/.openclaw/npm/projects/..., which
# is INSIDE the state volume — destroyed by `down -v` and impossible to pin in an
# image. So the Dockerfile installs it at build time and the config template
# points plugins.load.paths at the image copy instead.
#
# SLACK_PLUGIN_INTEGRITY is npm's own subresource integrity for the tarball, and
# it is checked against the resolved package-lock.json at BUILD time — the same
# "never trust the resolution, compare against a pin" rule as PRETORIN_SHA256.
# The published package ships its own npm-shrinkwrap.json (51 KB), which is what
# makes the 103-package transitive tree deterministic without vendoring a lock
# file here. Bumping the version REQUIRES re-deriving the integrity:
#   npm view @openclaw/slack@<version> dist.integrity
SLACK_PLUGIN_VERSION=2026.7.1
SLACK_PLUGIN_INTEGRITY=sha512-dwVGEVCmoTQrOIeZaSCIOPg8pT7hB883QQEXdp9EZUDzTGuvSc+KxH2iERSOV/59hROQctYdcobGn/vdB1H4XA==

# The published image.
#
# IMAGE_VERSION IS THE VERSION THIS CHECKOUT DEPLOYS — not the version being
# released. The RELEASE TAG is the source of truth for a release: `gh release
# create vX.Y.Z` and .github/workflows/release.yml derives the version from that
# tag (the same way pretorin-cli's release-binaries.yml does). Nothing here has to
# be bumped before cutting a release.
#
# This pair therefore moves ONCE, in the single commit that closes a release:
# IMAGE_VERSION and compose.yaml's digest pin are updated together to the image
# that was just published. compose.yaml restates the literal because compose cannot
# source a file, and scripts/smoke.sh asserts the two agree — a statement about the
# deployment, not about the release.
IMAGE_REPO=ghcr.io/pretorin-ai/compliance-claw
IMAGE_VERSION=0.2.2

# Release source: the PUBLIC homebrew tap, so the build needs no credentials.
# The private pretorin-ai/pretorin-cli publishes byte-identical assets but is not
# anonymously fetchable — the build must not depend on it.
#
# PRETORIN_TARGET is the architecture extension point. Upstream currently ships
# only linux-x86_64 and macos-arm64; there is no linux/arm64 artifact, which is
# why deployment targets an amd64 host.
PRETORIN_REPO=pretorin-ai/homebrew-tap
PRETORIN_TARGET=linux-x86_64

# Expected SHA256 of the Pretorin binary. The signature over SHA256SUMS already
# covers integrity and rollback; this pin additionally fails closed if the
# signing key itself is ever compromised and used to sign different bytes.
# Bumping PRETORIN_VERSION REQUIRES re-deriving this from the signed SHA256SUMS.
#
# THIS PIN GOVERNS THE SEED ONLY. Once a deployment has updated its CLI, the
# active binary is whatever `pretorin update` installed, and the thing standing
# behind those bytes is the CLI's own signature verification, not this line.
# SECURITY.md states that split, and what it costs, rather than leaving a reader
# to infer that a pin still covers a binary it no longer describes.
PRETORIN_SHA256=f7ae0bb5d1d8baae1126bf85da7a0ab19e6e6c52cc04c2e01001c84394dea711

# Supply-chain toolchain. Matches pretorin-cli tools/install-release-tools.sh.
# cosign MUST stay on the v2.x line: v3 removed `verify-blob --signature` and
# cannot verify these releases at all. SHA256 cross-verified against upstream's
# cosign_checksums.txt; changing COSIGN_VERSION REQUIRES re-pinning COSIGN_SHA256.
COSIGN_VERSION=v2.4.1
COSIGN_ASSET=cosign-linux-amd64
COSIGN_SHA256=8b24b946dd5809c6bd93de08033bcf6bc0ed7d336b7785787c080f574b89249b

# ONE cosign pin, and it is for the PRETORIN BINARY only.
#
# The pin above verifies the Pretorin release blob at build time (see
# scripts/verify-pretorin.sh). It has nothing to do with the Compliance Claw
# container image.
#
# THE COMPLIANCE CLAW IMAGE IS NOT SIGNED. There is no second cosign pin here
# because nothing signs the image, and a pin no job consumes would advertise a
# verification that does not happen. The image's integrity control is its
# IMMUTABLE DIGEST, pinned in compose.yaml.
#
# A digest is integrity, not authenticity: it proves WHAT you pulled, not WHO
# built it. That trade is stated plainly in SECURITY.md and README.md.
#
# PLANNED (production / internal pilot, not implemented here): image signing
# backed by Azure Key Vault, following the same approach the Pretorin CLI already
# uses for its releases. That will need its own pin, because the v2.4.1 above
# cannot move.

# Release-pipeline tooling, checksum-pinned the same way as cosign so CI installs
# no unverified binary. Assets are named from the version, so bumping either
# version REQUIRES re-deriving its checksum from the release's checksums file.
#   trivy: vulnerability scan, fails the release on fixable CRITICAL findings
#   syft:  SPDX SBOM, retained as a workflow artifact on the release run. It is
#          NOT attached to the image and NOT signed — attaching an SBOM as an OCI
#          attestation is itself a signing operation, and this image is unsigned.
TRIVY_VERSION=v0.73.0
TRIVY_SHA256=2edd39da482bb4e9831962487b68f68e3928ec3137794757f54d00383d79547b
SYFT_VERSION=v1.50.0
SYFT_SHA256=bf7b29ff57f06da30918266a0e1c2885a8f99784798d1bdb1628886aa015d788
