# Inputs of the Compliance Claw source-built OpenClaw base (see README.md).
# Read by regenerate-lock.sh and .github/workflows/openclaw-base.yml. Every
# value is checked before use; an empty LOCK_* value stops the build.
#
# This file is outside the Docker build context (.dockerignore allowlist), so
# it does not change the Claw image.

# Exact upstream source: openclaw/openclaw tag v2026.10.10.
OPENCLAW_VERSION=2026.10.10
OPENCLAW_SOURCE_REPOSITORY=openclaw/openclaw
OPENCLAW_SOURCE_COMMIT=7dc3350cb9f08fcf9a0af5c4845a20d5b2f1a8be
OPENCLAW_SOURCE_TAG=v2026.10.10
OPENCLAW_SOURCE_TAG_OBJECT=6eef4472c85436c7deb8563248827d7f6d29df67
OPENCLAW_SOURCE_URL=https://github.com/openclaw/openclaw/archive/7dc3350cb9f08fcf9a0af5c4845a20d5b2f1a8be.tar.gz
OPENCLAW_SOURCE_BYTES=179942270
OPENCLAW_SOURCE_SHA256=91f191e11ac7d02d97dc7246f4a713aee57c17de34c9771d7ad2951b5605d0bf

# Upstream files before the reviewed diffs. The Dockerfile is never patched.
UPSTREAM_DOCKERFILE_SHA256=1973dab73364587aa1e2979893e13c57797fd94580e2668a2ecbafcd41691571
UPSTREAM_WORKSPACE_SHA256=5af51204804d9eaabf3c16b23a9489f72e3b7cb7b302867219aab9b9e5853cbe
UPSTREAM_LOCK_SHA256=cac4e3810242167d941d14b6befd63959ca76bd10289437c33caa5366eeb383c

# One complete reviewed override set: experiment 2 r3, Seroval 1.6.11, joi 18.3.1.
WORKSPACE_DIFF_SHA256=0f1a331423855a25ba0d3c15eececcf9f442e3e2de3ece386e11b7230d76a794
PATCHED_WORKSPACE_SHA256=43cc82fd01280ff0cc63356c36e29901399e702fdd6088d3116ffca8c9e5bef6

# The combined lock is made ONCE by regenerate-lock.sh after LOCK_NOT_BEFORE
# (joi 18.3.1 published 2026-10-28T09:59:49.641Z; workspace minimumReleaseAge
# 10080 minutes, strict; policy unchanged). Empty until that lock is reviewed.
LOCK_NOT_BEFORE=2026-11-04T09:59:50Z
LOCK_DIFF_SHA256=
PATCHED_LOCK_SHA256=

# Lock regeneration method (the reviewed r3 method).
REGEN_NODE_IMAGE=docker.io/library/node:24.22.1-bookworm@sha256:6449e19d8184d84062525b6a7524def03146c2cb04a7f08b076680d0e8e4240a
REGEN_PLATFORM=linux/arm64

# Build arguments: the values of the official 2026.10.10 build
# (upstream .github/workflows/docker-release-prepare.yml at the source commit).
BUILD_ARG_GIT_COMMIT=7dc3350cb9f08fcf9a0af5c4845a20d5b2f1a8be
BUILD_ARG_OPENCLAW_BUILD_TIMESTAMP=2026-11-02T19:42:22.573Z
BUILD_ARG_OPENCLAW_DOCKER_BUILD_VERSION=2026.10.10
BUILD_ARG_OPENCLAW_EXTENSIONS=diagnostics-otel,codex
BUILD_ARG_GITHUB_ACTIONS=true
BUILD_PLATFORM=linux/amd64

# Comparison only: the official image that the base replaces, and the Node
# base that both share. The guard uses their amd64 RootFS diffIDs.
OFFICIAL_IMAGE=ghcr.io/openclaw/openclaw@sha256:2204bb95891c1047e24f79066aeb4273056876651b62e061e098160af9b3dcbb
NODE_SLIM_IMAGE=docker.io/library/node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205

# BuildKit for the docker-container builder (needed for provenance, SBOM and the
# OCI archive output): moby/buildkit v0.34.1, published 2026-10-20.
BUILDKIT_IMAGE=docker.io/moby/buildkit@sha256:99368f3e46177c6405b9740e4461d91cee004128daeecca78d4ceac50ec1da5c

# BuildKit SBOM generator, pinned (buildx --sbom). Provenance and SBOM are
# unsigned records, not a publisher signature.
SBOM_GENERATOR=docker.io/docker/buildkit-syft-scanner@sha256:873a7458c3c8ac8e32c7b796c10e1600b07b963d2aa000a72a2d97aaaa2d6315

# Publication target (design only until the publication review).
BASE_IMAGE_REPO=ghcr.io/pretorin-ai/compliance-claw-openclaw-base
BASE_IMAGE_TAG=2026.10.10-src.1
