// slack-channel.patch.json5 — the Slack half of the generated config.
//
// entrypoint.sh applies this with `openclaw config patch` on a FRESH SEED only,
// and only when .env supplies all three of SLACK_BOT_TOKEN, SLACK_APP_TOKEN and
// SLACK_CHANNEL_ID. A deployment without Slack never sees any of this and gets a
// config byte-identical to Phase 4's.
//
// Why a patch rather than part of openclaw-config.template.json:
//   - Slack is optional, and a config naming channels.slack with no tokens would
//     retry a websocket forever.
//   - `openclaw config patch` is upstream's own documented Slack setup command,
//     so the merge is schema-validated rather than hand-rolled JSON editing.
//   - The channel allowlist entry is a config KEY, and OpenClaw's ${VAR}
//     substitution only works on config VALUES — so the channel id has to be
//     substituted before the file is applied, which a patch file makes explicit.
//
// @SLACK_CHANNEL_ID@ has TWO fates, decided by whether efforts.yaml is mounted.
//
//   efforts.yaml PRESENT (the multi-effort deployment). The whole placeholder
//     LINE is deleted, leaving `channels: {}` — an empty allowlist. Which
//     channels are served is then `scripts/clawctl apply`'s business: it
//     generates one entry per effort from the same list it generates the
//     bindings from, so an admitted channel and a routed channel can never
//     drift. Deleting the line rather than substituting an empty string
//     matters: "" is a real key, and would be a routing rule for a channel
//     named nothing.
//
//   efforts.yaml ABSENT (legacy, pre-migration). Replaced by entrypoint.sh from
//     $SLACK_CHANNEL_ID, but only after the value matches ^C[A-Z0-9]{6,}$ and
//     only into a temporary copy — this file is never modified.
//
// Either way `config patch --dry-run` validates the result against the schema
// before anything is applied, so a malformed value is rejected twice over.
//
// NOTE ON COMMENTS: `config patch` rewrites ~/.openclaw/openclaw.json as strict
// JSON, so none of these comments reach the volume. They document the shipped
// intent for whoever reads the image, which is the same status Phase 4 assigned
// to the base template's comments after observing OpenClaw reformat the file.
{
  plugins: {
    // Activation allowlist. Official Slack trust comes from the managed npm
    // install, not from this list or an explicit local load path.
    //
    // This list limits activation. OpenClaw can add required provider and
    // memory plugins during migration. Inspect the loaded set after an upgrade;
    // do not treat a fixed plugin count as a security boundary.
    // Keep both local plugins here so their tools remain available.
    // If channels.slack is removed, review this allowlist too.
    allow: ["slack", "pretorin-update", "target-sync"],

    entries: { slack: { enabled: true } },

    // Keep plugins.load.paths from the base config. Slack is a managed install.
    // A patch array would replace all customer plugin paths.
  },

  channels: {
    slack: {
      enabled: true,

      // Socket Mode: the gateway dials OUT to slack.com over a websocket. It
      // needs no public URL, no inbound port and no reverse proxy, so
      // compose.yaml's 127.0.0.1:18789 publish stays exactly as strict as it is
      // without Slack. Upstream's transport table states "Public Gateway URL:
      // Not required" for this mode.
      mode: "socket",

      // NO botToken / appToken KEYS ON PURPOSE. OpenClaw falls back to
      // SLACK_BOT_TOKEN and SLACK_APP_TOKEN from the environment for the default
      // account, and compose's env_file already puts them there. The result is
      // stronger than the PRETORIN_API_KEY arrangement: the state volume holds
      // not even a ${VAR} marker for a Slack credential.

      // No DMs. A DM would be an unattributed private session speaking with the
      // deployment's Pretorin key, and OpenClaw's default for Slack DMs is
      // pairing rather than refusal. "disabled" is the posture this POC ships
      // until user-level attribution and RBAC exist.
      dmPolicy: "disabled",

      // Slack traffic may not rewrite the gateway's own configuration.
      //
      // This is why the CLI updater never touches config to force MCP to pick up
      // a new binary: it restarts the gateway through the supported restart RPC
      // instead. A config write from a Slack-triggered path would contradict
      // this line, and on a non-Slack deployment `openclaw config set` would
      // also rewrite the JSON5 template as strict JSON and delete every comment.
      configWrites: false,

      // HOW A SLACK USER REACHES A GATEWAY COMMAND.
      //
      // Native Slack slash commands are off by default (`commands.native: auto`
      // does not enable them for Slack), and Slack rejects an unregistered
      // `/foo` before it ever reaches us. This single registered command wraps
      // the rest, so the deterministic route is:
      //
      //     /compliance-claw /pretorin-update latest
      //     /compliance-claw /pretorin-update 0.28.7
      //     /compliance-claw /target-sync all
      //     /compliance-claw /target-sync simple-crm
      //
      // THE NAME MUST MATCH WHAT THE SLACK APP REGISTERS. Slack rejects an
      // unregistered `/foo` before it reaches the gateway, so this is not a free
      // choice: the shipped app registers /compliance-claw, and
      // slack/app-manifest.json declares the same. `ephemeral` keeps its default (true),
      // so the acknowledgement is visible just to the invoker while the outcome
      // — which changes the CLI for everyone — is delivered as a normal channel
      // message.
      slashCommand: {
        enabled: true,
        name: "compliance-claw",
      },

      // Only the channels listed below are served, and only on an explicit
      // @mention. Keys MUST be Slack channel IDs (C...): a name-based key such
      // as "#compliance" silently never routes under groupPolicy "allowlist",
      // which looks identical to the bot being broken.
      //
      // ON A MULTI-EFFORT DEPLOYMENT THIS MAP IS EMPTY HERE and is filled by
      // `scripts/clawctl apply` from each effort's slack_channel_id. Empty plus
      // "allowlist" means the bot answers nowhere until an operator applies,
      // which is the correct fail-closed state for a deployment that has been
      // started but not configured.
      //
      // Find the id: right-click the channel in Slack -> Copy link -> the C...
      // value at the end of the URL.
      groupPolicy: "allowlist",
      channels: {
        // `users` is what authorizes slash commands; without it OpenClaw refuses
        // every one. "*" means the members of this configured channel, which is
        // the trust boundary — groupPolicy "allowlist" serves nowhere else.
        "@SLACK_CHANNEL_ID@": { requireMention: true, users: ["*"] },
      },
    },
  },
}
